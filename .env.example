NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://medicloud:replace_me@localhost:5432/medicloud
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api
# Backend App ID token-validation endpoint and SPA audience/client ID.
APPID_OAUTH_SERVER_URL=
APPID_CLIENT_ID=
# Private local-development file store. Keep outside any public/static directory.
DOCUMENT_STORAGE_DIR=./private-documents
# Required in production. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# For local development, the API creates an ephemeral secret automatically if this is left unset.
JWT_SECRET=
